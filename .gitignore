# =============================================================================
# CBP Training Assistant — .gitignore
# =============================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# ---- Virtual Environments ----
.venv/
venv/
env/
ENV/

# ---- Django ----
*.log
db.sqlite3
db.sqlite3-journal
staticfiles/
media/

# ---- Node / React ----
frontend/node_modules/
frontend/build/
frontend/.pnp
frontend/.pnp.js
frontend/coverage/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Environment Variables (contain secrets) ----
.env
backend/.env
frontend/.env
*.env
.env.*

# ---- Whitelist .env.docker (safe to commit, contains no secrets) ----
!.env.docker

# ---- Credentials ----
credentials.json
*.pem
*.key
.credentials

# ---- Docker ----
docker-compose.override.yml

# ---- IDE / Editor ----
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.project
.classpath
.settings/

# ---- OS ----
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ---- Testing ----
test_result.md
.coverage
htmlcov/
.pytest_cache/
.tox/
.nox/

# ---- Logs ----
/var/log/

# ---- ML Model Cache (downloaded at runtime or baked into Docker) ----
*.bin
*.safetensors
.cache/

# ---- Qdrant Local Storage ----
/var/lib/qdrant/

# ---- Misc ----
*.bak
*.tmp
*.temp
