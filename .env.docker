# =============================================================================
# CBP Training Assistant — Docker Environment Configuration
#
# Copy this file to .env and customize values for your deployment:
#   cp .env.docker .env
#
# =============================================================================

# ---- PostgreSQL ----
PG_DB_NAME=cbp_db
PG_DB_USER=cbp_user
PG_DB_PASSWORD=cbp_pass
PG_EXTERNAL_PORT=5432

# ---- Qdrant (Local Container) ----
# Qdrant runs as a local container, no external server needed
QDRANT_EXTERNAL_PORT=6333
QDRANT_COLLECTION=cbp_training

# ---- Local Embedding Models (FastEmbed) ----
# Models are pre-downloaded and mounted from ./models directory
# Dense: nomic-ai/nomic-embed-text-v1.5 (768d, MRL-trained)
# Sparse: Qdrant/bm25 (BM25-based sparse embeddings)
# See: python download_models.py
MODELS_DIR=/app/models
DENSE_MODEL_NAME=nomic-ai/nomic-embed-text-v1.5
SPARSE_MODEL_NAME=Qdrant/bm25
DENSE_EMBEDDING_DIM=768
MRL_EMBEDDING_DIM=256
USE_MRL=true

# ---- Ollama (Local LLM Server) ----
# Ollama runs as a local container
# Models are stored in ./models/ollama directory
# See: python download_ollama_model.py
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_EXTERNAL_PORT=11434

# ---- Django ----
DJANGO_SECRET_KEY=change-me-in-production-use-a-long-random-string
DJANGO_DEBUG=False

# ---- Ports ----
BACKEND_EXTERNAL_PORT=8001
FRONTEND_EXTERNAL_PORT=3000
PROXY_PORT=8080

# ---- Frontend ----
# This is the URL the browser uses to reach the backend API.
# In production, set this to your public domain:
#   REACT_APP_BACKEND_URL=https://cbp-training.yourdomain.com
# For local Docker deployment, use the proxy port:
REACT_APP_BACKEND_URL=http://localhost:8080
